<%- include('partials/header', { title }) %>
<form class="filters" method="get">
  <% if (all) { %><div class="f" style="flex:2"><label>ค้นหา</label><input name="q" value="<%= q %>" placeholder="ชื่อหนังสือ หรือชื่อผู้ยืม"></div><% } %>
  <div class="f f-sm"><label>สถานะ</label><select name="status" onchange="this.form.submit()">
    <option value="">ทั้งหมด</option>
    <% Object.keys(statusText).forEach(k => { %><option value="<%= k %>" <%= k === status ? 'selected' : '' %>><%= statusText[k] %></option><% }) %>
  </select></div>
  <button class="btn btn-primary">กรอง</button>
  <% if (q || status) { %><a class="btn" href="/app/loans">ล้าง</a><% } %>
</form>
<div class="table-wrap"><table>
  <thead><tr><th>#</th><th>หนังสือ</th><% if (all) { %><th>ผู้ยืม</th><% } %><th>วันที่ขอ</th><th>กำหนดคืน</th><th>สถานะ</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(l => { %>
    <tr>
      <td><%= l.loan_id %></td>
      <td><a href="/app/loans/<%= l.loan_id %>"><b><%= l.title %></b></a></td>
      <% if (all) { %><td><%= l.full_name %><br><span class="muted small">@<%= l.username %></span></td><% } %>
      <td class="nowrap"><%= fmt(l.requested_at) %></td>
      <td class="nowrap"><%= l.status === 'approved' ? fmtDate(l.due_date) : '-' %> <% if (l.overdue) { %><span class="badge b-failure">เกินกำหนด</span><% } %></td>
      <td><%- include('partials/status', { s: l.status }) %></td>
      <td class="right"><a class="btn btn-sm" href="/app/loans/<%= l.loan_id %>">ดู</a></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% if (!rows.length) { %><div class="empty">ไม่มีรายการ</div><% } %></div>
<%- include('partials/pager') %>
<%- include('partials/footer') %>
